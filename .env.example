# Copy to .env and fill in. .env is git-ignored; this example file is committed.
# Anything set in the shell overrides the value here.

# Bedrock model: use the inference profile id (us.anthropic....), not the bare model id
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_REGION=us-east-1

# Named profile from ~/.aws/config (leave blank to use your default credentials)
AWS_PROFILE=

# "Continue with Google" (optional). Client ID from your Google Cloud OAuth client; the client secret
# goes in Secrets Manager (aws-quiz/google-client-secret), not here. See README: Google sign-in.
GOOGLE_CLIENT_ID=

# Custom domain (optional). Site at SITE_DOMAIN, sign-in pages at auth.<HOSTED_ZONE>,
# and the bare HOSTED_ZONE name also opens the site. See README: Custom domain.
SITE_DOMAIN=
HOSTED_ZONE=
# AUTH_DOMAIN=auth.example.com   (default; set to none to keep the amazoncognito.com sign-in address)

# Email + password sign-up next to Google (optional): on, or leave blank for Google only.
# Turn on only after SES shows kirangunturu.com as Verified and production access is granted.
# See README: Email sign-up.
EMAIL_SIGNUP=

# Google Search Console (optional): the TXT value Search Console shows when you add the domain,
# e.g. google-site-verification=AbC123... Deploy adds it to Route 53. See README: Search.
GOOGLE_SITE_VERIFICATION=
